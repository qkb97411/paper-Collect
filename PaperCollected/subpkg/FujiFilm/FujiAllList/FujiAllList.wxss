/* subpkg/FujiFilm/FujiAllList/FujiAllList.wxss */
.container {
  padding: 30rpx;
}
.title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #a05c38;
}
.item {
  font-size: 28rpx;
  line-height: 2;
  color: #666;
}

/* 容器：绝对居中 + 全屏背景 */
.paper-container {
  width: 100%;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f7f3f0;
  position: relative;
}

/* 相纸公共样式 */
.paper {
  position: absolute;
  background-color: #fff;
  border-radius: 8rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.2);
  transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  cursor: pointer;
  z-index: 1;

  /* 让相纸本身居中定位 */
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
}

/* 相纸中间的照片色块（核心） */
.paper-photo {
  position: absolute;
  left: 50%;
  top: 46%;
  transform: translate(-50%, -50%);
  background-color: #e6e6e6; /* 浅灰模拟照片 */
  border-radius: 4rpx;
}

/* 白边文字 */
.paper-label {
  position: absolute;
  bottom: 20rpx;
  width: 100%;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

/* --------------------- */
/* 三种相纸尺寸 & 叠放错位 */
/* --------------------- */

/* mini 相纸（最上层 最小） */
.paper-mini {
  width: 360rpx;/* 原始尺寸64 */
  height: 574rpx;/* 原始尺寸86*/
  z-index: 3;
  transform: translate(calc(-50% - 150rpx), calc(-50% - 250rpx));
}
.paper-mini .paper-photo {
  width: 307rpx;/* 原始尺寸46 */
  height: 414rpx;/* 原始尺寸62 */
}

/* Square 方形相纸（中间） */
.paper-square {
  width: 480rpx;/* 原始尺寸72 */
  height: 574rpx;/* 原始尺寸86 */
  z-index: 2;
  transform: translate(-50%, -50%);
}
.paper-square .paper-photo {
  width: 414rpx;/* 原始尺寸62 */
  height: 414rpx;/* 原始尺寸62 */
}

/* wide 相纸（最底层 最大） */
.paper-wide {
  width: 720rpx;/* 原始尺寸108 */
  height: 574rpx;/* 原始尺寸86 */
  z-index: 1;
  transform: translate(calc(-50% + 0rpx), calc(-50% + 250rpx));
}
.paper-wide .paper-photo {
  width: 660rpx;/* 原始尺寸99 */
  height: 414rpx;/* 原始尺寸62 */
}

/* --------------------- */
/* 点击弹出动画 */
/* --------------------- */
.paper.active {
  transform: translate(-50%, -50%) scale(1.15);
  z-index: 10;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}