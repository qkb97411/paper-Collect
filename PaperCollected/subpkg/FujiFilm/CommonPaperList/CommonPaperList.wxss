/* 容器正常从上到下排列 */
.container {
  padding: 20rpx;
  background: #f7f3f0;
  min-height: 100vh;
  display: block;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #a05c38;
  text-align: center;
  margin: 30rpx 0 40rpx;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #a05c38;
  font-size: 28rpx;
}

/* 一行两个卡片布局 */
.card-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.card {
  width: 48%;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.1);
  box-sizing: border-box;
}

.card-img {
  width: 100%;
  height: 320rpx;
  border-radius: 8rpx;
  background: #f1f1f1;
}

.card-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-top: 15rpx;
  text-align: center;
}

.empty {
  width: 100%;
  text-align: center;
  padding: 50rpx 0;
  color: #999;
  font-size: 28rpx;
}