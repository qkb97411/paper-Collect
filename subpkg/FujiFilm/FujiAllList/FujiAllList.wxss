/* subpkg/FujiFilm/FujiAllList/FujiAllList.wxss */
.container {
  padding: 30rpx;
}
.title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #a05c38;
}
.item {
  font-size: 28rpx;
  line-height: 2;
  color: #666;
}

/* 容器：绝对居中 + 全屏背景 */
.paper-container {
  width: 100%;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f7f3f0;
  position: relative;
  overflow: hidden; /* 新增：防止缩放溢出 */
}

/* 相纸公共样式 */
.paper {
  position: absolute;
  background-color: #fff;
  border-radius: 8rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.2);
  transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  cursor: pointer;
  z-index: 1;

  /* 让相纸本身居中定位 */
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
}

/* 相纸中间的照片色块（核心） */
.paper-photo {
  position: absolute;
  left: 50%;
  top: 46%;
  transform: translate(-50%, -50%);
  background-color: #e6e6e6; /* 浅灰模拟照片 */
  border-radius: 4rpx;
  overflow: visible;
}

/* 白边文字 */
.paper-label {
  position: absolute;
  bottom: 20rpx;
  width: 100%;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.paper-dim {
  position: absolute;
  color: #8c5e4b;
  font-size: 22rpx;
  line-height: 1;
  text-align: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
  z-index: 5;
}

.paper.active .paper-dim {
  opacity: 1;
}

.paper-dim-outer-width {
  left: 50%;
  top: 12rpx;
  transform: translateX(-50%);
}

.paper-dim-outer-height {
  right: 10rpx;
  top: 50%;
  transform: translateY(-50%);
  writing-mode: vertical-rl;
}

.paper-dim-inner-width {
  left: 50%;
  top: 10rpx;
  transform: translateX(-50%);
}

.paper-dim-inner-height {
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  writing-mode: vertical-rl;
}

.paper > .paper-dim-outer-width {
  top: 12rpx;
}

.paper > .paper-dim-outer-height {
  right: 10rpx;
}

.paper-photo > .paper-dim-inner-width {
  top: 10rpx;
}

.paper-photo > .paper-dim-inner-height {
  right: 8rpx;
}

/* --------------------- */
/* 三种相纸尺寸 & 叠放错位 */
/* --------------------- */

/* mini 相纸（最上层 最小） */
.paper-mini {
  width: 360rpx;/* 原始尺寸64 */
  height: 574rpx;/* 原始尺寸86*/
  z-index: 3;
  transform: translate(calc(-50% - 150rpx), calc(-50% - 250rpx));
}
.paper-mini .paper-photo {
  width: 307rpx;/* 原始尺寸46 */
  height: 414rpx;/* 原始尺寸62 */
}

/* Square 方形相纸（中间） */
.paper-square {
  width: 480rpx;/* 原始尺寸72 */
  height: 574rpx;/* 原始尺寸86 */
  z-index: 2;
  transform: translate(-50%, -50%);
}
.paper-square .paper-photo {
  width: 414rpx;/* 原始尺寸62 */
  height: 414rpx;/* 原始尺寸62 */
}

/* wide 相纸（最底层 最大） */
.paper-wide {
  width: 720rpx;/* 原始尺寸108 */
  height: 574rpx;/* 原始尺寸86 */
  z-index: 1;
  transform: translate(calc(-50% + 0rpx), calc(-50% + 250rpx));
}
.paper-wide .paper-photo {
  width: 660rpx;/* 原始尺寸99 */
  height: 414rpx;/* 原始尺寸62 */
}

/* --------------------- */
/* 点击弹出动画 */
/* --------------------- */
.paper.active {
  transform: translate(-50%, -50%) scale(1.1);
  z-index: 10;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

.paper-wide.active {
  transform: translate(-50%, -50%);
}

.paper-action-hint {
  position: absolute;
  left: 50%;
  bottom: 72rpx;
  transform: translate(-50%, 20rpx);
  max-width: 560rpx;
  padding: 18rpx 32rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #8c5e4b;
  font-size: 26rpx;
  line-height: 1.3;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  opacity: 0;
  pointer-events: none;
  transition: all 0.24s ease;
  z-index: 20;
}

.paper-action-hint.show {
  opacity: 1;
  transform: translate(-50%, 0);
}
