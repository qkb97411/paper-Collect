.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 48rpx;
  box-sizing: border-box;
  background: #f7f3f0;
  position: relative;
}

.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.profile-card,
.section-title,
.primary-tabs,
.sub-type-scroll,
.stats-row,
.loading,
.error {
  position: relative;
  z-index: 1;
}

.profile-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.avatar-wrap {
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  line-height: 1;
}

.avatar-wrap::after {
  display: none;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #e8dfd4;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #888;
}

.profile-meta {
  flex: 1;
  margin-left: 24rpx;
}

.nick-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx 16rpx;
}

.nick-display {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  max-width: 100%;
}

.nick-edit-hint {
  font-size: 22rpx;
  color: #999;
  line-height: 1.2;
}

.nick-modal {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.nick-modal-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.nick-modal-panel {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx 28rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
}

.nick-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.nick-modal-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  border: 1rpx solid #e8dfd4;
  border-radius: 12rpx;
  box-sizing: border-box;
  margin-bottom: 32rpx;
}

.nick-modal-actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  gap: 20rpx;
}

.nick-modal-btn {
  margin: 0;
  padding: 0 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.nick-modal-btn::after {
  display: none;
}

.nick-modal-btn.cancel {
  background: #f2f2f2;
  color: #666;
}

.nick-modal-btn.ok {
  background: #a05c38;
  color: #fff;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #a05c38;
  margin: 16rpx 0 16rpx;
}

.primary-tabs {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.tab-pill {
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #666;
  font-size: 26rpx;
  border: 2rpx solid #e8dfd4;
}

.tab-pill.active {
  background: #a05c38;
  color: #fff;
  border-color: #a05c38;
}

.sub-type-scroll {
  width: 100%;
  white-space: nowrap;
  margin-top: 12rpx;
  margin-bottom: 24rpx;
}

.sub-type-row {
  display: inline-flex;
  flex-direction: row;
  gap: 16rpx;
  padding-bottom: 8rpx;
}

.chip {
  display: inline-block;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #555;
  font-size: 24rpx;
  border: 2rpx solid #e0d6cc;
}

.chip-active {
  border-color: #1a5f8a;
  color: #1a5f8a;
  background: #e8f2fa;
}

.stats-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.05);
}

.stat-label {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 12rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

.stat-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #aaa;
}

.loading,
.error {
  margin-top: 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #888;
}

.error {
  color: #bd5757;
}
